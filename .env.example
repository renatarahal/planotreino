# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use a chave anon/publishable, NUNCA a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# E-mail da conta única da família (criada em Authentication > Users).
# A tela de login pede só a senha; este e-mail é usado por trás.
VITE_FAMILY_EMAIL=familia@exemplo.com

# Modo demonstração, sem Supabase (só funciona em desenvolvimento). Senha: treino123
# VITE_DEMO=true
